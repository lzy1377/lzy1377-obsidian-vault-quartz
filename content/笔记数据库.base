views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("笔记")
        - file.ext.containsAll("md")
        - '!file.name.contains("index")'
    order:
      - file.name
      - description
      - tags
      - type
      - created
      - updated
    sort:
      - property: file.name
        direction: ASC
